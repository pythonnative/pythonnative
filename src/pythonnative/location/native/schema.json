{
  "components": {},
  "modules": {
    "Location": {
      "events": {
        "position": {
          "additionalProperties": {
            "type": "json"
          },
          "type": "object"
        }
      },
      "methods": {
        "get_current": {
          "arguments": {
            "accuracy": {
              "enum": [
                "balanced",
                "high"
              ]
            },
            "timeout": {
              "type": "number"
            }
          },
          "async": true,
          "defaults": {
            "accuracy": "balanced",
            "timeout": 10.0
          },
          "required": [],
          "result": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "start_watching": {
          "arguments": {
            "accuracy": {
              "enum": [
                "balanced",
                "high"
              ]
            },
            "distance": {
              "type": "number"
            }
          },
          "async": true,
          "defaults": {
            "accuracy": "balanced",
            "distance": 0.0
          },
          "required": [],
          "result": {
            "type": "integer"
          }
        },
        "stop_watching": {
          "arguments": {
            "id": {
              "type": "integer"
            }
          },
          "async": false,
          "defaults": {},
          "required": [
            "id"
          ],
          "result": {
            "type": "null"
          }
        }
      },
      "name": "Location"
    }
  },
  "protocol": 8,
  "yoga": "3.2.1"
}
